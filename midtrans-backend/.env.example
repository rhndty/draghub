# Salin file ini menjadi .env lalu isi dengan key dari dashboard Midtrans.
# JANGAN commit file .env (sudah masuk .gitignore).

# Server Key dari Dashboard Midtrans > Settings > Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-ytg9gp20uytFKh73Qt39DyRu

# Client Key (dipakai hanya kalau nanti mau pakai Snap.js di web)
MIDTRANS_CLIENT_KEY=Mid-client-TIdShzVjbH2G24d_

# false = Sandbox (untuk praktikum), true = Production (uang asli!)
MIDTRANS_IS_PRODUCTION=false

# URL publik backend ini.
# - Saat lokal pakai ngrok: https://xxxx-xxx-xxx.ngrok-free.app
# - Saat deploy Vercel: https://nama-project.vercel.app
# Dipakai untuk halaman "finish" yang dibuka setelah pembayaran selesai.
PUBLIC_BASE_URL=https://spiritism-bunny-expenses.ngrok-free.dev

# Port untuk server lokal
PORT=3000

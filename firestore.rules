rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function hasRole(roles) {
      return isSignedIn() && getUserRole() in roles;
    }

    function isPanitia() {
      return hasRole(['bendahara', 'ketua', 'wakil', 'sekretaris', 'super_admin']);
    }

    // 1. KOLEKSI USERS
    // Akun baru wajib ber-role 'anggota' dan client dilarang mengubah field 'role'
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.role == 'anggota';
      allow update: if isOwner(uid)
                    && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // 2. KOLEKSI MOTORCYCLES (Garasi Motor Pembalap)
    match /motorcycles/{bikeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn()
                            && resource.data.userId == request.auth.uid;
    }

    // 3. KOLEKSI EVENTS
    match /events/{eventId} {
      allow read: if isSignedIn();
      // Seluruh Panitia (Sekretaris, Ketua, Wakil, Bendahara) diizinkan membuat event
      allow create: if isPanitia();
      // Update diizinkan untuk panitia pengelola atau penambahan counter nomor balap saat pelunasan
      allow update: if isPanitia()
                    || (isSignedIn() && (resource.data.status in ['PUBLISHED', 'UPCOMING', 'DRAFT']));
      allow delete: if hasRole(['ketua', 'wakil']);
    }

    // 4. KOLEKSI EVENT_REGISTRATIONS
    match /event_registrations/{registrationId} {
      allow read: if isSignedIn();

      // Rider mendaftar event (atau Panitia membuat pendaftaran testing / on-behalf)
      allow create: if isSignedIn()
                    && (
                      (request.resource.data.userId == request.auth.uid
                        && request.resource.data.paymentStatus == 'PENDING'
                        && request.resource.data.assignedStartNumber == null
                        && request.resource.data.attendanceStatus == 'PENDING'
                        && request.resource.data.scrutineeringStatus == 'PENDING')
                      || isPanitia()
                    );

      // Update berdasarkan peran sesuai RBAC PRD v1.4:
      allow update: if
        // A. Rider mengunggah ulang bukti bayar setelah ditolak (REJECTED -> PENDING)
        (isSignedIn()
          && resource.data.userId == request.auth.uid
          && resource.data.paymentStatus == 'REJECTED'
          && request.resource.data.paymentStatus == 'PENDING'
          && request.resource.data.assignedStartNumber == null)
        // B. Pelunasan otomatis via Midtrans Sandbox oleh rider bersangkutan
        || (isOwner(resource.data.userId)
          && resource.data.paymentStatus == 'PENDING'
          && request.resource.data.paymentStatus == 'PAID')
        // C. Bendahara memverifikasi atau menolak pembayaran manual
        || hasRole(['bendahara'])
        // D. Sekretaris memverifikasi kehadiran & scrut awal (tidak bisa mengubah yang sudah DISQUALIFIED)
        || (hasRole(['sekretaris'])
          && resource.data.scrutineeringStatus != 'DISQUALIFIED')
        // E. Ketua & Wakil memiliki akses penuh (termasuk scrut ulang atas keberatan rider)
        || hasRole(['ketua', 'wakil']);

      allow delete: if false;
    }

    // 5. KOLEKSI RACE_RESULTS (Telemetri Waktu Balap)
    match /race_results/{resultId} {
      allow read: if isSignedIn();
      allow create, update: if hasRole(['wakil', 'ketua']);
      allow delete: if false;
    }

    // 6. KOLEKSI KAS_TRANSACTIONS
    match /kas_transactions/{transactionId} {
      // Hanya Panitia yang bisa melihat riwayat kas, anggota TIDAK BISA
      allow read: if isPanitia();

      // Pencatatan kas masuk/keluar oleh Bendahara atau otomatis dari payment gateway Midtrans
      allow create: if hasRole(['bendahara'])
                    || (isSignedIn() && request.resource.data.paymentMethod != null);
      allow update: if hasRole(['bendahara']);

      // Bendahara (dan Ketua/Wakil) diizinkan menghapus transaksi jika terjadi kesalahan input
      allow delete: if hasRole(['bendahara', 'ketua', 'wakil']);
    }
  }
}

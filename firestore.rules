rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function hasRole(roles) {
      return isSignedIn() && getUserRole() in roles;
    }

    function isPanitia() {
      return hasRole(['bendahara', 'ketua', 'wakil', 'sekretaris', 'super_admin']);
    }

    // 1. KOLEKSI USERS
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.role == 'anggota';
      allow update: if isOwner(uid)
                    && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // 2. KOLEKSI MOTORCYCLES
    match /motorcycles/{bikeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn()
                            && resource.data.userId == request.auth.uid;
    }

    // 3. KOLEKSI EVENTS (Aman dari manipulasi rider)
    match /events/{eventId} {
      allow read: if isSignedIn();
      // Sekretaris, Ketua, dan Wakil diizinkan membuat draft event baru
      allow create: if isPanitia() || hasRole(['sekretaris', 'ketua', 'wakil']);
      // Panitia bisa update status; Pembalap hanya boleh menaikkan counter saat pelunasan
      allow update: if isPanitia()
                    || (isSignedIn() 
                        && resource.data.status == 'PUBLISHED'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredCount'])
                        && request.resource.data.registeredCount == resource.data.registeredCount + 1);
      allow delete: if hasRole(['ketua', 'wakil']);
    }
    

    // 4. KOLEKSI EVENT_REGISTRATIONS
    match /event_registrations/{registrationId} {
      allow read: if isSignedIn();

      // Rider mendaftar event (atau Panitia mendaftarkan on-behalf)
      allow create: if isSignedIn()
                    && (
                      (request.resource.data.userId == request.auth.uid
                        && request.resource.data.paymentStatus == 'PENDING'
                        && request.resource.data.assignedStartNumber == null
                        && request.resource.data.attendanceStatus == 'PENDING'
                        && request.resource.data.scrutineeringStatus == 'PENDING')
                      || isPanitia()
                    );

      // Update RBAC PRD v1.4
      allow update: if
        // A. Rider upload ulang bukti bayar jika ditolak
        (isSignedIn()
          && resource.data.userId == request.auth.uid
          && resource.data.paymentStatus == 'REJECTED'
          && request.resource.data.paymentStatus == 'PENDING'
          && request.resource.data.assignedStartNumber == null)
        // B. Pelunasan otomatis Midtrans oleh rider pemilik pendaftaran
        || (isOwner(resource.data.userId)
          && resource.data.paymentStatus == 'PENDING'
          && request.resource.data.paymentStatus == 'PAID')
        // C. Bendahara memverifikasi atau menolak transfer manual
        || hasRole(['bendahara'])
        // D. Sekretaris verifikasi kehadiran & meja scrut fisik
        || (hasRole(['sekretaris'])
          && resource.data.scrutineeringStatus != 'DISQUALIFIED')
        // E. Ketua & Wakil (Akses penuh & scrut ulang)
        || hasRole(['ketua', 'wakil']);

      allow delete: if false;
    }

    // 5. KOLEKSI RACE_RESULTS (Telemetri Waktu Balap)
    match /race_results/{resultId} {
      allow read: if isSignedIn();
      allow create, update: if hasRole(['wakil', 'ketua']);
      allow delete: if false;
    }

    // 6. KOLEKSI KAS_TRANSACTIONS
    match /kas_transactions/{transactionId} {
      allow read: if isPanitia();
      // Bendahara manual atau sistem otomatis saat rider melunasi pendaftaran
      allow create: if hasRole(['bendahara'])
                    || (isSignedIn() && request.resource.data.type == 'IN');
      allow update: if hasRole(['bendahara']);
      allow delete: if hasRole(['bendahara', 'ketua', 'wakil']);
    }
  }
}